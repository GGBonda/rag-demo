# ===========================================
# RAG 知识库 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ===========================================

# -------- MinerU 云 API 配置 --------
MINERU_API_TOKEN=your-mineru-api-token-here

# -------- Embedding 模型配置 --------
# OpenAI 或兼容 OpenAI Embeddings 协议的云平台
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_BASE_URL=https://api.openai.com/v1

# -------- PGvector 数据库配置 --------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=rag_knowledge_base
PG_USER=postgres
PG_PASSWORD=postgres
# PGvector 表名
PG_TABLE_NAME=documents

# -------- 文档分片配置 --------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
INDEX_CHUNK_DESCRIPTION_COUNT=3
